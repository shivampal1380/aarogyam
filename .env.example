# Client Environment Variables (prefix with VITE_)
# Google Apps Script Web App URL (deployed from your Sheet) that appends responses
# to your Google Sheet automatically. e.g. https://script.google.com/macros/s/AKfycb.../exec
VITE_GOOGLE_SHEETS_URL=

# Fixed Razorpay Payment Link (configured in your Razorpay dashboard)
VITE_RAZORPAY_PAYMENT_URL=https://pages.razorpay.com/pl_YOUR_PAYMENT_LINK_ID/view

VITE_WHATSAPP_NUMBER=919999999999
VITE_WHATSAPP_MESSAGE=Hello Aarogyam Wellness Centre, I have successfully registered for the workshop. Thank You.
